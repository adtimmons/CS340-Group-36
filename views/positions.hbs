<section class="page-heading">
    <h2>Positions</h2>
    <p>Manage production positions, staffing requirements, and qualifying skills.</p>
</section>

<section class="panel">
    <h3>Existing Positions</h3>

    <table>
        <thead>
            <tr>
                <th>Position ID</th>
                <th>Position Name</th>
                <th>Assembly Line</th>
                <th>Required Staff</th>
                <th>Qualifying Skill</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each positions}}
            <tr>
                <td>{{this.positionID}}</td>
                <td>{{this.positionName}}</td>
                <td>{{this.lineName}}</td>
                <td>{{this.requiredStaff}}</td>
                <td>{{this.skillName}}</td>
                <td>
                    <button type="button">Edit</button>
                    <button type="button" class="danger">Delete</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="6">No positions found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Position</h3>

    <form action="/positions/add" method="POST">
        <label for="positionName">Position name</label>
        <input
            type="text"
            id="positionName"
            name="positionName"
            required
        >

        <label for="lineID">Assembly line</label>
        <select id="lineID" name="lineID" required>
            <option value="">Select a line</option>

            {{#each lines}}
            <option value="{{this.lineID}}">
                {{this.lineName}}
            </option>
            {{/each}}
        </select>

        <label for="requiredStaff">Required staff</label>
        <input
            type="number"
            id="requiredStaff"
            name="requiredStaff"
            min="1"
            required
        >

        <label for="qualifyingSkillID">Qualifying skill</label>
        <select
            id="qualifyingSkillID"
            name="qualifyingSkillID"
            required
        >
            <option value="">Select a skill</option>

            {{#each skills}}
            <option value="{{this.skillID}}">
                {{this.skillName}}
            </option>
            {{/each}}
        </select>

        <button type="submit">Add Position</button>
    </form>
</section>
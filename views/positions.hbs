<section class="page-heading">
    <h2>Positions</h2>
    <p>Manage production positions, staffing requirements, and qualifying skills.</p>
</section>

<section class="panel">
    <h3>Existing Positions</h3>

    <table>
        <thead>
            <tr>
                <th>Position ID</th>
                <th>Position Name</th>
                <th>Line</th>
                <th>Required Staff</th>
                <th>Qualifying Skill</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each positions}}
            <tr>
                <td>{{this.positionID}}</td>
                <td>{{this.positionName}}</td>
                <td>{{this.lineName}}</td>
                <td>{{this.requiredStaff}}</td>
                <td>{{this.skillName}}</td>
                <td>
                    <form
                        action="/positions/delete"
                        method="POST"
                        style="display:inline;"
                    >
                        <input
                            type="hidden"
                            name="positionID"
                            value="{{this.positionID}}"
                        >

                        <button
                            type="submit"
                            class="danger"
                            onclick="return confirm('Delete this position?');"
                        >
                            Delete
                        </button>
                    </form>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="6">No positions found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Position</h3>

    <form action="/positions/add" method="POST">

        <label for="positionName">Position name</label>
        <input
            type="text"
            id="positionName"
            name="positionName"
            required
        >

        <label for="lineID">Line</label>
        <select id="lineID" name="lineID" required>
            <option value="">Select a Line</option>

            {{#each lines}}
            <option value="{{this.lineID}}">
                {{this.lineName}}
            </option>
            {{/each}}
        </select>

        <label for="requiredStaff">Required staff</label>
        <input
            type="number"
            id="requiredStaff"
            name="requiredStaff"
            min="1"
            required
        >

        <label for="qualifyingSkillID">Qualifying skill</label>
        <select
            id="qualifyingSkillID"
            name="qualifyingSkillID"
            required
        >
            <option value="">Select a Skill</option>

            {{#each skills}}
            <option value="{{this.skillID}}">
                {{this.skillName}}
            </option>
            {{/each}}
        </select>

        <button type="submit">
            Add Position
        </button>
    </form>
</section>

<section class="panel">
    <h3>Update a Position</h3>

    <form action="/positions/update" method="POST">

        <label for="updatePositionID">Position</label>
        <select
            id="updatePositionID"
            name="positionID"
            required
        >
            <option value="">Select a Position</option>

            {{#each positions}}
            <option value="{{this.positionID}}">
                {{this.positionName}}
            </option>
            {{/each}}
        </select>

        <label for="updatePositionName">Position name</label>
        <input
            type="text"
            id="updatePositionName"
            name="positionName"
            required
        >

        <label for="updateLineID">Line</label>
        <select
            id="updateLineID"
            name="lineID"
            required
        >
            <option value="">Select a Line</option>

            {{#each lines}}
            <option value="{{this.lineID}}">
                {{this.lineName}}
            </option>
            {{/each}}
        </select>

        <label for="updateRequiredStaff">Required staff</label>
        <input
            type="number"
            id="updateRequiredStaff"
            name="requiredStaff"
            min="1"
            required
        >

        <label for="updateQualifyingSkillID">
            Qualifying skill
        </label>
        <select
            id="updateQualifyingSkillID"
            name="qualifyingSkillID"
            required
        >
            <option value="">Select a Skill</option>

            {{#each skills}}
            <option value="{{this.skillID}}">
                {{this.skillName}}
            </option>
            {{/each}}
        </select>

        <button type="submit">
            Update Position
        </button>
    </form>
</section>
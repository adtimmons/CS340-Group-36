<section class="page-heading">
    <h2>Daily Assignments</h2>
    <p>Assign team members to positions for each production schedule.</p>
</section>

<section class="panel">
    <h3>Current Daily Assignments</h3>

    <table>
        <thead>
            <tr>
                <th>Assignment ID</th>
                <th>Date</th>
                <th>Shift</th>
                <th>Team Member</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each dailyAssignments}}
            <tr>
                <td>{{this.assignmentID}}</td>
                <td>{{this.scheduleDate}}</td>
                <td>{{this.shiftName}}</td>
                <td>{{this.teamMemberName}}</td>
                <td>{{this.positionName}}</td>
                <td>
                    <button type="button">Edit</button>
                    <button type="button" class="danger">Delete</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="6">No daily assignments found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Daily Assignment</h3>

    <form action="/daily-assignments/add" method="POST">

        <label for="scheduleID">Schedule</label>
        <select id="scheduleID" name="scheduleID" required>
            <option value="">Select a Schedule</option>

            {{#each schedules}}
            <option value="{{this.scheduleID}}">
                {{this.scheduleDate}} - {{this.shiftName}}
            </option>
            {{/each}}
        </select>

        <label for="teamMemberID">Team Member</label>
        <select id="teamMemberID" name="teamMemberID" required>
            <option value="">Select a Team Member</option>

            {{#each teamMembers}}
            <option value="{{this.teamMemberID}}">
                {{this.teamMemberName}}
            </option>
            {{/each}}
        </select>

        <label for="positionID">Position</label>
        <select id="positionID" name="positionID" required>
            <option value="">Select a Position</option>

            {{#each positions}}
            <option value="{{this.positionID}}">
                {{this.positionName}}
            </option>
            {{/each}}
        </select>

        <button type="submit">
            Add Assignment
        </button>

    </form>
</section>
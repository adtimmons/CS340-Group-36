<section class="page-heading">
    <h2>Daily Assignments</h2>
    <p>Manage team member assignments for scheduled production shifts.</p>
</section>

<section class="panel">
    <h3>Existing Daily Assignments</h3>

    <table>
        <thead>
            <tr>
                <th>Assignment ID</th>
                <th>Schedule</th>
                <th>Shift</th>
                <th>Team Member</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each dailyAssignments}}
            <tr>
                <td>{{this.assignmentID}}</td>
                <td>{{this.scheduleDate}}</td>
                <td>{{this.shiftName}}</td>
                <td>{{this.teamMemberName}}</td>
                <td>{{this.positionName}}</td>
                <td>
                    <form
                        action="/daily-assignments/delete"
                        method="POST"
                        style="display:inline;"
                    >
                        <input
                            type="hidden"
                            name="assignmentID"
                            value="{{this.assignmentID}}"
                        >

                        <button
                            type="submit"
                            class="danger"
                            onclick="return confirm('Delete this assignment?');"
                        >
                            Delete
                        </button>
                    </form>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="6">No assignments found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Daily Assignment</h3>

    <form action="/daily-assignments/add" method="POST">

        <label for="scheduleID">Schedule</label>
        <select id="scheduleID" name="scheduleID" required>
            <option value="">Select a schedule</option>

            {{#each schedules}}
            <option value="{{this.scheduleID}}">
                {{this.scheduleDate}} - {{this.shiftName}}
            </option>
            {{/each}}
        </select>

        <label for="teamMemberID">Team Member</label>
        <select id="teamMemberID" name="teamMemberID" required>
            <option value="">Select a team member</option>

            {{#each teamMembers}}
            <option value="{{this.teamMemberID}}">
                {{this.teamMemberName}}
            </option>
            {{/each}}
        </select>

        <label for="positionID">Position</label>
        <select id="positionID" name="positionID" required>
            <option value="">Select a position</option>

            {{#each positions}}
            <option value="{{this.positionID}}">
                {{this.positionName}}
            </option>
            {{/each}}
        </select>

        <button type="submit">
            Add Assignment
        </button>
    </form>
</section>

<section class="panel">
    <h3>Update a Daily Assignment</h3>

    <form action="/daily-assignments/update" method="POST">

        <label for="updateAssignmentID">Assignment</label>
        <select
            id="updateAssignmentID"
            name="assignmentID"
            required
        >
            <option value="">Select an assignment</option>

            {{#each dailyAssignments}}
            <option value="{{this.assignmentID}}">
                Assignment {{this.assignmentID}} -
                {{this.teamMemberName}} -
                {{this.positionName}}
            </option>
            {{/each}}
        </select>

        <label for="updateScheduleID">Schedule</label>
        <select
            id="updateScheduleID"
            name="scheduleID"
            required
        >
            <option value="">Select a schedule</option>

            {{#each schedules}}
            <option value="{{this.scheduleID}}">
                {{this.scheduleDate}} - {{this.shiftName}}
            </option>
            {{/each}}
        </select>

        <label for="updateTeamMemberID">Team Member</label>
        <select
            id="updateTeamMemberID"
            name="teamMemberID"
            required
        >
            <option value="">Select a team member</option>

            {{#each teamMembers}}
            <option value="{{this.teamMemberID}}">
                {{this.teamMemberName}}
            </option>
            {{/each}}
        </select>

        <label for="updatePositionID">Position</label>
        <select
            id="updatePositionID"
            name="positionID"
            required
        >
            <option value="">Select a position</option>

            {{#each positions}}
            <option value="{{this.positionID}}">
                {{this.positionName}}
            </option>
            {{/each}}
        </select>

        <button type="submit">
            Update Assignment
        </button>
    </form>
</section>
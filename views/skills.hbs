<section class="page-heading">
    <h2>Skills</h2>
    <p>Manage the skills used to qualify team members for production positions.</p>
</section>

<section class="panel">
    <h3>Existing Skills</h3>

    <table>
        <thead>
            <tr>
                <th>Skill ID</th>
                <th>Skill Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each skills}}
            <tr>
                <td>{{this.skillID}}</td>
                <td>{{this.skillName}}</td>
                <td>{{this.skillDescription}}</td>
                <td>
                    <button type="button">Edit</button>
                    <button type="button" class="danger">Delete</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="4">No skills found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Skill</h3>

    <form action="/skills/add" method="POST">
        <label for="skillName">Skill name</label>
        <input
            type="text"
            id="skillName"
            name="skillName"
            required
        >

        <label for="skillDescription">Skill description</label>
        <textarea
            id="skillDescription"
            name="skillDescription"
            rows="4"
        ></textarea>

        <button type="submit">Add Skill</button>
    </form>
</section>
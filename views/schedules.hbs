<section class="page-heading">
    <h2>Schedules</h2>
    <p>Manage production schedules.</p>
</section>

<section class="panel">
    <h3>Existing Schedules</h3>

    <table>
        <thead>
            <tr>
                <th>Schedule ID</th>
                <th>Date</th>
                <th>Shift</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each schedules}}
            <tr>
                <td>{{this.scheduleID}}</td>
                <td>{{this.scheduleDate}}</td>
                <td>{{this.shiftName}}</td>
                <td>
                    <button type="button">Edit</button>
                    <button type="button" class="danger">Delete</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="4">No schedules found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Schedule</h3>

    <form action="/schedules/add" method="POST">

        <label for="scheduleDate">Date</label>
        <input
            type="date"
            id="scheduleDate"
            name="scheduleDate"
            required
        >

        <label for="shiftName">Shift</label>
        <select id="shiftName" name="shiftName" required>
            <option value="">Select a Shift</option>
            <option value="1st Shift">1st Shift</option>
            <option value="2nd Shift">2nd Shift</option>
            <option value="3rd Shift">3rd Shift</option>
        </select>

        <button type="submit">
            Add Schedule
        </button>

    </form>
</section>
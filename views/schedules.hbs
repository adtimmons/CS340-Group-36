<section class="page-heading">
    <h2>Schedules</h2>
    <p>Manage production schedules and shifts.</p>
</section>

<section class="panel">
    <h3>Existing Schedules</h3>

    <table>
        <thead>
            <tr>
                <th>Schedule ID</th>
                <th>Date</th>
                <th>Shift</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each schedules}}
            <tr>
                <td>{{this.scheduleID}}</td>
                <td>{{this.scheduleDate}}</td>
                <td>{{this.shiftName}}</td>
                <td>
                    <form
                        action="/schedules/delete"
                        method="POST"
                        style="display:inline;"
                    >
                        <input
                            type="hidden"
                            name="scheduleID"
                            value="{{this.scheduleID}}"
                        >

                        <button
                            type="submit"
                            class="danger"
                            onclick="return confirm('Delete this schedule?');"
                        >
                            Delete
                        </button>
                    </form>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="4">No schedules found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Schedule</h3>

    <form action="/schedules/add" method="POST">

        <label for="scheduleDate">Date</label>
        <input
            type="date"
            id="scheduleDate"
            name="scheduleDate"
            required
        >

        <label for="shiftName">Shift</label>
        <select
            id="shiftName"
            name="shiftName"
            required
        >
            <option value="">Select a shift</option>
            <option value="Day">Day</option>
            <option value="Night">Night</option>
        </select>

        <button type="submit">
            Add Schedule
        </button>
    </form>
</section>

<section class="panel">
    <h3>Update a Schedule</h3>

    <form action="/schedules/update" method="POST">

        <label for="updateScheduleID">
            Schedule
        </label>

        <select
            id="updateScheduleID"
            name="scheduleID"
            required
        >
            <option value="">Select a schedule</option>

            {{#each schedules}}
            <option value="{{this.scheduleID}}">
                {{this.scheduleID}} - {{this.scheduleDate}} - {{this.shiftName}}
            </option>
            {{/each}}
        </select>

        <label for="updateScheduleDate">
            Date
        </label>

        <input
            type="date"
            id="updateScheduleDate"
            name="scheduleDate"
            required
        >

        <label for="updateShiftName">
            Shift
        </label>

        <select
            id="updateShiftName"
            name="shiftName"
            required
        >
            <option value="">Select a shift</option>
            <option value="Day">Day</option>
            <option value="Night">Night</option>
        </select>

        <button type="submit">
            Update Schedule
        </button>
    </form>
</section>
<section class="page-heading">
    <h2>Team Member Skills</h2>

    <p>
        Assign skills to team members and manage the many-to-many
        relationship.
    </p>
</section>

<section class="panel">
    <h3>Current Skill Assignments</h3>

    <table>
        <thead>
            <tr>
                <th>Team Member</th>
                <th>Skill</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>Jordan Smith</td>
                <td>Packing</td>
                <td>
                    <button type="button" class="danger">
                        Remove Skill
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Assign a Skill</h3>

    <form>
        <label for="teamMemberID">Team member</label>
        <select id="teamMemberID" name="teamMemberID" required>
            <option value="">Select a team member</option>
            <option value="101">Jordan Smith</option>
            <option value="102">Casey Brown</option>
        </select>

        <label for="skillID">Skill</label>
        <select id="skillID" name="skillID" required>
            <option value="">Select a skill</option>
            <option value="1">Packing</option>
            <option value="2">Scaling</option>
            <option value="3">Lead</option>
        </select>

        <button type="submit">Assign Skill</button>
    </form>
</section>
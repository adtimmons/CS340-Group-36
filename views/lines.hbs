<section class="page-heading">
    <h2>Assembly Lines</h2>
    <p>Browse, add, update, and delete production lines.</p>
</section>

<section class="panel">
    <h3>Existing Lines</h3>

    <table>
        <thead>
            <tr>
                <th>Line ID</th>
                <th>Line Name</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each lines}}
            <tr>
                <td>{{this.lineID}}</td>
                <td>{{this.lineName}}</td>
                <td>{{this.department}}</td>
                <td>
                    <button type="button">Edit</button>
                    <button type="button" class="danger">Delete</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="4">No assembly lines found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Line</h3>

    <form action="/lines/add" method="POST">
        <label for="lineName">Line Name</label>
        <input
            type="text"
            id="lineName"
            name="lineName"
            required
        >

        <label for="department">Department</label>
        <input
            type="text"
            id="department"
            name="department"
            required
        >

        <button type="submit">Add Line</button>
    </form>
</section>
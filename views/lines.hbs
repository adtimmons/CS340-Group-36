<section class="page-heading">
    <h2>Assembly Lines</h2>
    <p>Browse, add, update, and delete production lines.</p>
</section>

<section class="panel">
    <h3>Existing Lines</h3>

    <table>
        <thead>
            <tr>
                <th>Line ID</th>
                <th>Line Name</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each lines}}
            <tr>
                <td>{{this.lineID}}</td>
                <td>{{this.lineName}}</td>
                <td>{{this.department}}</td>
                <td>
                    <form
                        action="/lines/delete"
                        method="POST"
                        style="display:inline;"
                    >
                        <input
                            type="hidden"
                            name="lineID"
                            value="{{this.lineID}}"
                        >

                        <button
                            type="submit"
                            class="danger"
                            onclick="return confirm('Delete this line?');"
                        >
                            Delete
                        </button>
                    </form>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="4">No lines found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Line</h3>

    <form action="/lines/add" method="POST">

        <label for="lineName">Line name</label>
        <input
            type="text"
            id="lineName"
            name="lineName"
            required
        >

        <label for="department">Department</label>
        <input
            type="text"
            id="department"
            name="department"
            required
        >

        <button type="submit">
            Add Line
        </button>
    </form>
</section>

<section class="panel">
    <h3>Update a Line</h3>

    <form action="/lines/update" method="POST">

        <label for="updateLineID">
            Line
        </label>

        <select
            id="updateLineID"
            name="lineID"
            required
        >
            <option value="">Select a Line</option>

            {{#each lines}}
            <option value="{{this.lineID}}">
                {{this.lineName}}
            </option>
            {{/each}}
        </select>

        <label for="updateLineName">
            Line name
        </label>

        <input
            type="text"
            id="updateLineName"
            name="lineName"
            required
        >

        <label for="updateDepartment">
            Department
        </label>

        <input
            type="text"
            id="updateDepartment"
            name="department"
            required
        >

        <button type="submit">
            Update Line
        </button>
    </form>
</section>
<section class="page-heading">
    <h2>Home</h2>

    <p>
        Welcome to the Production Staffing Management System.
    </p>
</section>

<section class="dashboard-panel">
    <h3>System Overview</h3>

    <p>
        This application allows supervisors to manage production lines,
        team member records, production positions, employee skills,
        schedules, and daily staffing assignments.
    </p>

    <p>
        Use the navigation menu at the top of the page to access each section.
    </p>
</section>

<section class="panel">
    <h3>Reset Database</h3>

    <p>
        Restore all tables and sample data to their original state.
    </p>

    <form action="/reset" method="POST">
        <button
            type="submit"
            class="danger"
            onclick="return confirm('Reset the entire database?');"
        >
            Reset Database
        </button>
    </form>
</section>

<section class="dashboard-summary">
    <div class="summary-card">
        <p class="summary-label">Team Members</p>
        <p class="summary-number">{{teamMemberCount}}</p>
        <p class="summary-note">Active employee records</p>
    </div>

    <div class="summary-card">
        <p class="summary-label">Production Lines</p>
        <p class="summary-number">{{lineCount}}</p>
        <p class="summary-note">Lines currently tracked</p>
    </div>

    <div class="summary-card">
        <p class="summary-label">Positions</p>
        <p class="summary-number">{{positionCount}}</p>
        <p class="summary-note">Production positions</p>
    </div>

    <div class="summary-card">
        <p class="summary-label">Schedules</p>
        <p class="summary-number">{{scheduleCount}}</p>
        <p class="summary-note">Upcoming schedules</p>
    </div>
</section>
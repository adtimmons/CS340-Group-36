<section class="page-heading">
    <h2>Team Members</h2>
    <p>Manage employee records and home-line assignments.</p>
</section>

<section class="panel">
    <h3>Existing Team Members</h3>

    <table>
        <thead>
            <tr>
                <th>TM ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Home Line</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each teamMembers}}
            <tr>
                <td>{{this.teamMemberID}}</td>
                <td>{{this.firstName}}</td>
                <td>{{this.lastName}}</td>
                <td>{{this.lineName}}</td>
                <td>{{this.employmentStatus}}</td>
                <td>
                    <form
                        action="/team-members/delete"
                        method="POST"
                        style="display:inline;"
                    >
                        <input
                            type="hidden"
                            name="teamMemberID"
                            value="{{this.teamMemberID}}"
                        >

                        <button
                            type="submit"
                            class="danger"
                            onclick="return confirm('Delete this team member?');"
                        >
                            Delete
                        </button>
                    </form>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="6">No team members found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Team Member</h3>

    <form action="/team-members/add" method="POST">

        <label for="firstName">First name</label>
        <input
            type="text"
            id="firstName"
            name="firstName"
            required
        >

        <label for="lastName">Last name</label>
        <input
            type="text"
            id="lastName"
            name="lastName"
            required
        >

        <label for="homeLineID">Home line</label>
        <select id="homeLineID" name="homeLineID" required>
            <option value="">Select a line</option>

            {{#each lines}}
            <option value="{{this.lineID}}">
                {{this.lineName}}
            </option>
            {{/each}}
        </select>

        <label for="employmentStatus">Employment status</label>
        <select
            id="employmentStatus"
            name="employmentStatus"
            required
        >
            <option value="">Select a status</option>
            <option value="Active">Active</option>
            <option value="Leave">Leave</option>
            <option value="Inactive">Inactive</option>
        </select>

        <button type="submit">
            Add Team Member
        </button>
    </form>
</section>

<section class="panel">
    <h3>Update a Team Member</h3>

    <form action="/team-members/update" method="POST">

        <label for="updateTeamMemberID">
            Team Member
        </label>

        <select
            id="updateTeamMemberID"
            name="teamMemberID"
            required
        >
            <option value="">Select a Team Member</option>

            {{#each teamMembers}}
            <option value="{{this.teamMemberID}}">
                {{this.firstName}} {{this.lastName}}
            </option>
            {{/each}}
        </select>

        <label for="updateFirstName">First name</label>
        <input
            type="text"
            id="updateFirstName"
            name="firstName"
            required
        >

        <label for="updateLastName">Last name</label>
        <input
            type="text"
            id="updateLastName"
            name="lastName"
            required
        >

        <label for="updateHomeLineID">Home line</label>
        <select
            id="updateHomeLineID"
            name="homeLineID"
            required
        >
            <option value="">Select a line</option>

            {{#each lines}}
            <option value="{{this.lineID}}">
                {{this.lineName}}
            </option>
            {{/each}}
        </select>

        <label for="updateEmploymentStatus">
            Employment status
        </label>

        <select
            id="updateEmploymentStatus"
            name="employmentStatus"
            required
        >
            <option value="">Select a status</option>
            <option value="Active">Active</option>
            <option value="Leave">Leave</option>
            <option value="Inactive">Inactive</option>
        </select>

        <button type="submit">
            Update Team Member
        </button>
    </form>
</section>
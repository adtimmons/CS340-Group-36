<section class="page-heading">
    <h2>Team Members</h2>
    <p>Manage employee records and home-line assignments.</p>
</section>

<section class="panel">
    <h3>Existing Team Members</h3>

    <table>
        <thead>
            <tr>
                <th>TM ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Home Line</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each teamMembers}}
            <tr>
                <td>{{this.teamMemberID}}</td>
                <td>{{this.firstName}}</td>
                <td>{{this.lastName}}</td>
                <td>{{this.lineName}}</td>
                <td>{{this.employmentStatus}}</td>
                <td>
                    <button type="button">Edit</button>
                    <button type="button" class="danger">Delete</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="6">No team members found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Add a Team Member</h3>

    <form action="/team-members/add" method="POST">
        <label for="firstName">First name</label>
        <input
            type="text"
            id="firstName"
            name="firstName"
            required
        >

        <label for="lastName">Last name</label>
        <input
            type="text"
            id="lastName"
            name="lastName"
            required
        >

        <label for="homeLineID">Home line</label>
        <select id="homeLineID" name="homeLineID" required>
            <option value="">Select a line</option>

            {{#each lines}}
            <option value="{{this.lineID}}">
                {{this.lineName}}
            </option>
            {{/each}}
        </select>

        <label for="employmentStatus">Employment status</label>
        <select id="employmentStatus" name="employmentStatus" required>
            <option value="">Select a status</option>
            <option value="Active">Active</option>
            <option value="Leave">Leave</option>
            <option value="Inactive">Inactive</option>
        </select>

        <button type="submit">Add Team Member</button>
    </form>
</section>